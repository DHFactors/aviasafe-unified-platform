rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // SUPER ADMIN: Full access to everything
    // ========================================================================
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.role == 'SUPER_ADMIN';
    }

    // ========================================================================
    // TENANTS COLLECTION - Any authenticated user can read
    // ========================================================================
    match /tenants/{tenantId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.token.role == 'SUPER_ADMIN';
    }

    // ========================================================================
    // TENANT DATA - Tenant isolation
    // ========================================================================
    match /tenants/{tenantId}/{document=**} {
      allow read: if request.auth != null &&
        (request.auth.token.tenant_id == tenantId || request.auth.token.role == 'SUPER_ADMIN');
      allow write: if request.auth != null &&
        (request.auth.token.tenant_id == tenantId || request.auth.token.role == 'SUPER_ADMIN');
    }

    // ========================================================================
    // SURVEY RESPONSES - Anonymous submission allowed
    // ========================================================================
    match /tenants/{tenantId}/responses/{document=**} {
      allow create: if true;
      allow read: if request.auth != null &&
        (request.auth.token.tenant_id == tenantId || request.auth.token.role == 'SUPER_ADMIN');
      allow update, delete: if false;
    }

    // ========================================================================
    // SAFETY REPORTS - Authenticated users only
    // ========================================================================
    match /tenants/{tenantId}/reports/{document=**} {
      allow create: if request.auth != null && request.auth.token.tenant_id == tenantId;
      allow read: if request.auth != null &&
        (request.auth.token.tenant_id == tenantId || request.auth.token.role == 'SUPER_ADMIN');
    }

  }
}
